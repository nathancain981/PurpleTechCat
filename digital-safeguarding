    <!-- Accessibility Panel -->
<div id="a11y-panel" class="a11y-panel">
  <h2>Accessibility Tools</h2>

  <button class="a11y-tool" onclick="toggleDyslexia()">Dyslexia‑friendly font</button>
  <button class="a11y-tool" onclick="increaseText()">Increase text size</button>
  <button class="a11y-tool" onclick="decreaseText()">Decrease text size</button>
  <button class="a11y-tool" onclick="toggleContrast()">High contrast mode</button>
  <button class="a11y-tool" onclick="toggleMotion()">Reduce motion</button>

  <button id="a11y-close" class="a11y-close">Close</button>
</div>

